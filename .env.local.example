# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Get these from https://neon.tech → your project → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get from https://resend.com → API Keys
AUTH_RESEND_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="noreply@yourdomain.com"

# ─── GitHub OAuth (optional) ──────────────────────────────────────────────────
# Create at https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# ─── Vercel Blob (for image uploads) ──────────────────────────────────────────
# Auto-provided by Vercel when you add Blob storage
# For local dev: get from Vercel dashboard → Storage → Blob → .env.local
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"
